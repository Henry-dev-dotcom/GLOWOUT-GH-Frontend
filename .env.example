# GLOWOUT GH frontend API configuration
#
# Local development points straight at the local backend:
VITE_API_URL=http://localhost:5000/api
#
# On Vercel (production), leave this as a relative path so requests go through
# the same-origin proxy defined in vercel.json (which forwards /api/* to the
# Railway backend). Using the same origin keeps the auth cookie first-party and
# avoids third-party-cookie blocking. Set in the Vercel dashboard:
#   VITE_API_URL=/api

# Set to false if you want to force the frontend to use localStorage demo data only.
VITE_BACKEND_ENABLED=true

# Google Sign-In client ID (the same OAuth Web Client ID configured on the
# backend). Leave blank to hide the Google button. Get it from
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
