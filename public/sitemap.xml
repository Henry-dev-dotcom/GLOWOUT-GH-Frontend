<?xml version="1.0" encoding="UTF-8"?>
<!--
  Replace YOUR-DOMAIN with your production domain before launch.
  Product URLs (/product/<id>) are added automatically by the prerender step
  when it runs at build time (see scripts/prerender.mjs). The routes below are
  the stable public pages.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://YOUR-DOMAIN/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>https://YOUR-DOMAIN/shop</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>https://YOUR-DOMAIN/categories</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://YOUR-DOMAIN/about</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>https://YOUR-DOMAIN/contact</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>https://YOUR-DOMAIN/faq</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  <url><loc>https://YOUR-DOMAIN/returns</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  <url><loc>https://YOUR-DOMAIN/reviews</loc><changefreq>weekly</changefreq><priority>0.4</priority></url>
  <url><loc>https://YOUR-DOMAIN/blog</loc><changefreq>weekly</changefreq><priority>0.5</priority></url>
  <url><loc>https://YOUR-DOMAIN/terms</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
  <url><loc>https://YOUR-DOMAIN/privacy</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
</urlset>
